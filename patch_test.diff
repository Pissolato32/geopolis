+          origin.endsWith(".webcontainer.io");
+        const isExplicitlyAllowed = ALLOWED_ORIGINS.includes(origin);
+        if (isDevelopmentPreview || isExplicitlyAllowed) {
+          res.header("Access-Control-Allow-Origin", origin);
+          res.header("Vary", "Origin");
